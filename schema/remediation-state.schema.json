{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RemediationStateObject",
  "type": "object",
  "properties": {
    "findingIndex": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "domainAssignments": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "retryCount": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "deepResearchResults": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "fixedFindings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failedFindings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "RESOLVED",
        "ESCALATED",
        "HUMAN_REQUIRED",
        "IN_PROGRESS"
      ]
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "fixCommitSha": {
      "type": "string"
    },
    "fixCommitShas": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "findingIndex",
    "domainAssignments",
    "retryCount",
    "deepResearchResults",
    "fixedFindings",
    "failedFindings",
    "outcome"
  ]
}
