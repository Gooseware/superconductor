{
  "mcpServers": {
    "superconductor-kernel": {
      "command": "node",
      "args": [
        "./packages/superconductor-kernel/dist/index.js"
      ],
      "env": {
        "PROJECT_ROOT": "${WORKSPACE_ROOT}",
        "SUPERCONDUCTOR_DIR": "${EXTENSION_DIR}"
      }
    },
    "superconductor-browser": {
      "command": "node",
      "args": [
        "./packages/superconductor-browser/dist/mcp/index.js"
      ],
      "env": {
        "PROJECT_ROOT": "${WORKSPACE_ROOT}",
        "SUPERCONDUCTOR_DIR": "${EXTENSION_DIR}"
      }
    }
  }
}
