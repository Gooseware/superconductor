#!/bin/bash
# Superconductor commit-msg hook
# Validates SwarmAuthorizer trailer on superconductor delivery commits

COMMIT_MSG_FILE="$1"

# Only validate if Node.js and the validator script are available
if command -v node &>/dev/null && [ -f "$(git rev-parse --show-toplevel)/scripts/validate-trailer.mjs" ]; then
  node "$(git rev-parse --show-toplevel)/scripts/validate-trailer.mjs" "$COMMIT_MSG_FILE"
  exit $?
fi

# Fallback: basic string check
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
if echo "$COMMIT_MSG" | grep -qE '^(feat|fix|track)\(superconductor\):'; then
  if ! echo "$COMMIT_MSG" | grep -q 'SwarmAuthorizer:'; then
    echo "[❌ Superconductor] Missing SwarmAuthorizer trailer on delivery commit." >&2
    exit 1
  fi
fi

exit 0
