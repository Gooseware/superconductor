#!/bin/bash
# Superconductor SignOff enforcement hook
# Verifies SHA-256 signed approval token for track branches

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null)

# Only enforce on track branches
if [[ "$BRANCH" != track/* ]]; then
  exit 0
fi

TRACK_ID=$(echo "$BRANCH" | sed 's|track/||')

if ! grep -q "^Swarm-Authorized:" "$1"; then
  echo "[Superconductor] Missing Swarm-Authorized: trailer in commit message."
  exit 1
fi

# Read quorum state from LibSQL or verify-signoff script
STATE_DB="${HOME}/.superconductor/quorum-state.db"
LOCAL_DB="superconductor/quorum/quorum_state.db"
SIGNOFF_FILE="superconductor/quorum/signoff_${TRACK_ID}.json"

if [ ! -f "$STATE_DB" ] && [ ! -f "$LOCAL_DB" ] && [ ! -f "$SIGNOFF_FILE" ] && [[ "$SUPERCONDUCTOR_FLAGS" != *"--no-signoff"* ]]; then
  echo "[Superconductor] No quorum state DB or sign-off file found. Run /superconductor:implement to complete sign-off."
  exit 1
fi

VERIFY_SCRIPT=""
if [ -n "${SUPERCONDUCTOR_DIR:-}" ] && [ -f "${SUPERCONDUCTOR_DIR}/scripts/hooks/verify-signoff.mjs" ]; then
  VERIFY_SCRIPT="${SUPERCONDUCTOR_DIR}/scripts/hooks/verify-signoff.mjs"
elif [ -f "$(dirname "$0")/verify-signoff.mjs" ]; then
  VERIFY_SCRIPT="$(dirname "$0")/verify-signoff.mjs"
else
  exit 0
fi

VERIFY_RESULT=$(node "$VERIFY_SCRIPT" "$TRACK_ID" 2>&1)
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo "[Superconductor] SignOff token invalid or missing: $VERIFY_RESULT"
  echo "[Superconductor] Run /superconductor:implement to complete sign-off."
  exit 1
fi

echo "[Superconductor] Sign-off verified: $VERIFY_RESULT"
exit 0
